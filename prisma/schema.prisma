generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Module {
  id              String     @id @default(cuid())
  name            String
  subject         String
  priorityPercent Float
  tier            Int
  examPart        String
  questions       Question[]
}

model Question {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])
}
